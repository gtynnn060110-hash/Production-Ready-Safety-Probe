      "revision": "976d9fbb0f52bce704dcbef5bd7a2652e65f2a21",
      "enabled": true,
      "notes": "完整default config、test split；区域config为其子集，judge_prompts不属于样本。",
      "allow_patterns": [
        "README.md",
        "category_*.csv"
      ],
      "fields": {
        "prompt": "prompt",
        "responses": [],
        "metadata": [
          "cate-idx",
          "l2-name",
          "l3-name",
          "l4-name"
        ]
      },
      "imports": [
        {
          "glob": "category_*.csv",
          "source_config": "default",
          "source_split": "test"
        }
      ]
    },
    {
      "name": "vlsbench",
      "allow_image_only": true,
      "repo_id": "Foreshhh/vlsbench",
      "revision": "b56f6f6aad102fdb53f46e35fec96836bbe13001",
      "enabled": true,
      "notes": "JSON与图片等价导入官方default/train，保留纯图片样本；不重复下载Parquet/tar。",
      "allow_patterns": [
        "README.md",
        "data.json",
        "imgs/*"
      ],
      "fields": {
        "prompt": "instruction",
        "responses": [],
        "images": "image_path",
        "metadata": [
          "instruction_id",
          "category",
          "sub_category",
          "source"
        ]
      },
      "imports": [
        {
          "glob": "data.json",
          "source_config": "default",
          "source_split": "train"
        }
      ]
    },
    {
      "name": "jailbreakv",
      "image_path_maps": [
        {
          "prefix": "query_related/",
